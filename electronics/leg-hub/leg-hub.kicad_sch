				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "2c82cad1-4c8b-567f-a47b-6f7e565e40a2")
	)
	(text "Kelvin-route R1 sense lines\nto U2 pins 10 / 9"
		(exclude_from_sim no)
		(at 17.78 125.222 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "38a3e42f-4c2e-52fd-bde7-4c57e92b3ef5")
	)
	(text "1 · Battery input, protection and current sense"
		(exclude_from_sim no)
		(at 17.78 22.86 0)
		(effects
